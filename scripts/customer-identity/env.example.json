{
  "schema": "xiaozhi-identity-env-v1",
  "issuer": "https://identity.example.invalid/oidc",
  "record_root": "/home/operator/private/identity-rounds",
  "db": {
    "container": "identity-check-db",
    "database": "identity_check",
    "network_alias": "mysql"
  },
  "identity_container": "identity-check-api",
  "entry": {
    "container": "identity-check-entry",
    "notify_log": "/var/log/nginx/identity-notify.log",
    "config_file": "/home/operator/private/identity-entry.conf",
    "marker": "IDENTITY CHECK"
  }
}
