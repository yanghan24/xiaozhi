# 复制到本机私有运行目录的 config/dev.env 后填写。
# Compose 启动时使用 XIAOZHI_RUNTIME_DIR 找到该目录。
# MySQL 和 Redis 使用本项目的独立开发实例。
SPRING_DATASOURCE_DRUID_URL=jdbc:mysql://DEV_MYSQL_HOST:13306/xiaozhi_dev?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&nullCatalogMeansCurrent=true&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_DRUID_USERNAME=xiaozhi_dev
SPRING_DATASOURCE_DRUID_PASSWORD=
SPRING_DATA_REDIS_HOST=DEV_REDIS_HOST
SPRING_DATA_REDIS_PORT=16380
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_PASSWORD=
