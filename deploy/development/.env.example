# 从仓库根目录运行 python3 scripts/init-manager.py 生成私有 .env 和数据库密码。
# 已有根目录 .env 时，使用原配置和对应的数据卷。
XIAOZHI_PROJECT_NAME=xiaozhi-baseline
MANAGER_PORT=18002
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# 默认标签用于工作区构建。按源码提交构建时可填写实际提交。
BUILD_TAG=baseline-local
SOURCE_REVISION=working-tree

# 仅在加入语音 Compose 时使用。
VOICE_WS_PORT=18000
VOICE_HTTP_PORT=18003
VOICE_BUILD_TAG=baseline-local
VOICE_SOURCE_REVISION=working-tree
