+namespace {
+esp_netif_t* trial_netif = nullptr;
+bool portal_closing = false;  // Accessed by the single HTTP task, reset before it starts.
+std::mutex preference_mutex;
+std::string preferred_station;
+
+void PreferStation(const std::string& ssid) {
+    std::lock_guard<std::mutex> lock(preference_mutex);
+    preferred_station = ssid;
+}
+
+using Form = std::unique_ptr<cJSON, decltype(&cJSON_Delete)>;
+
+Form ReadForm(httpd_req_t* request) {
+    if (!request->content_len || request->content_len > 1024) {
+        return {nullptr, cJSON_Delete};
+    }
+    std::string body(request->content_len, '\0');
+    size_t offset = 0;
+    while (offset < body.size()) {
+        const int count = httpd_req_recv(request, body.data() + offset, body.size() - offset);
+        if (count <= 0) {
+            return {nullptr, cJSON_Delete};
+        }
+        offset += count;
+    }
+    return {cJSON_ParseWithLength(body.c_str(), body.size() + 1), cJSON_Delete};
+}
+
+bool SchedulePortalExit(std::function<void()>* on_exit) {
+    if (portal_closing) {
+        return true;
+    }
+    portal_closing = true;
+    if (xTaskCreate([](void* context) {
+            // Let the current HTTP response reach the caller before stopping the portal.
+            vTaskDelay(pdMS_TO_TICKS(200));
+            auto& callback = *static_cast<std::function<void()>*>(context);
+            if (callback) {
+                callback();
+            }
+            vTaskDelete(nullptr);
+        }, "exit_config_task", 4096, on_exit, 5, nullptr) != pdPASS) {
+        portal_closing = false;
+        return false;
+    }
+    return true;
+}
+}  // namespace
+
+std::string TakePreferredProvisioningNetwork() {
+    std::lock_guard<std::mutex> lock(preference_mutex);
+    std::string ssid;
+    ssid.swap(preferred_station);
+    return ssid;
+}
