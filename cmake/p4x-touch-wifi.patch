+    memcpy(candidate.sta.ssid, ssid.data(), ssid.size());
+    memset(candidate.sta.password, 0, sizeof(candidate.sta.password));
+    memcpy(candidate.sta.password, password.data(), password.size());
+    candidate.sta.bssid_set = false;
+    candidate.sta.channel = 0;
+    candidate.sta.scan_method = WIFI_ALL_CHANNEL_SCAN;
+    candidate.sta.threshold.authmode = WIFI_AUTH_OPEN;
+    xEventGroupClearBits(event_group_, WIFI_TRIAL_ADDRESS | WIFI_TRIAL_DOWN);
