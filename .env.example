# Generate local random passwords with: python3 scripts/init-manager.py
# Keep .env outside version control. Do not replace credentials after initialization.
XIAOZHI_PROJECT_NAME=xiaozhi-baseline
MANAGER_PORT=18002
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Use a source commit as BUILD_TAG and SOURCE_REVISION for a committed build.
BUILD_TAG=baseline-local
SOURCE_REVISION=working-tree
